Algoritmo ejercicio6
	definir num1, num2, num3, media Como Real
	//Preguntamos al usuario por los valores de las variables
	Escribir "Introduce tres números por teclado: "
	Leer num1, num2, num3
	//Calculamos la media aritmetica
	media<-(num1+num2+num3)/3
	//Imprimimos el mensaje por pantalla
	Escribir "La media aritmética es: ", media
FinAlgoritmo
