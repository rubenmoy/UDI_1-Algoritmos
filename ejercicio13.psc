Algoritmo ejercicio13
	definir num,r2,r3 Como Real
	//Pedimos los datos por teclado y calculamos
	Escribir "Introduce un número por teclado :"
	leer num
	r2<-num^0.5
	r3<-num^(1/3)
	//Imprimimos el mensaje por pantalla
	Escribir "La raíz cuadrada del número es:",r2
	Escribir "La raíz cúbica del número es:",r3
FinAlgoritmo
