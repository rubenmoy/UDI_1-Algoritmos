Algoritmo ejercicio9
	Definir precio, descuento, total como real
	//Definimos el descuento del 15 %
	descuento<-0.85
	Escribir "Introduce el precio del artículo :"
	leer precio
	//Imprimimos el mensaje por pantalla despues de calcular el total
	total<-precio*descuento
	Escribir "El precio a pagar con el descuento es de :", total, " euros"
FinAlgoritmo
