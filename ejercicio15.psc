Algoritmo ejercicio15
	Definir a,b,c Como Real
	Escribir "Introduce el primer número por teclado: "
	leer a
	Escribir "Introduce el segundo número por teclado: "
	leer b 
	Escribir "Se intercambiaran los valores de las variables"
