Algoritmo ejercicio11
	Definir num1,num2,distancia como real
	//Preguntamos al usuario por los datos y calculamos el resultado 
	Escribir "Introduce dos números por teclado :"
	leer num1, num2
	distancia<-abs(num1-num2)
	//Imprimimos el mensaje por pantalla
	Escribir "La distancia entre los dos números es de :", distancia," unidades"
FinAlgoritmo
