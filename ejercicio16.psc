Algoritmo ejercicio16
	Definir v1,v2,d,t como real
	//Pedimos la distancia
	Escribir "Introduce la distancia a la que se encuentran los vehículos en km: "
	leer d
	//Calculamos a partir de la velocidad de cada coche despejando t de la ecuacion de MRU igualada y despejada
	v1<-100
	v2<-120
	t<-(d/20)*60
	//Imprimimos el mensaje por pantalla
	Escribir "El tiempo que tardará el vehículo 2 en alcanzar el vehículo 1 es de: ",t," minutos."
FinAlgoritmo
