Algoritmo ejercicio2
	definir perimetro,area,lado1,lado2 Como Real
	//Pedimos al usuario los datos 
	escribir "Introduce un lado del rectángulo."
	leer lado1
	escribir "Introduce el lado contiguo del rectangulo."
	leer lado2
	//Realizamos el calculo 
	perimetro<-2*(lado1+lado2)
	area<-lado1*lado2
	//Imprimimos el resultado
	escribir "El área del rectángulo vale : ", area , " unidades , mientras que el perímetro vale ", perimetro ," unidades."
FinAlgoritmo
